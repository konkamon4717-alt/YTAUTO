# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงในไฟล์นั้น
# ห้ามใส่ค่าจริงในไฟล์นี้ เพราะ .env.example ถูก commit ขึ้น git ส่วน .env ไม่ถูก commit
#
# ใส่เฉพาะค่าหลัง = เท่านั้น ไม่ต้องใส่เครื่องหมายคำพูด ไม่ต้องเว้นวรรค
# ตัวอย่างที่ถูก:  KAGGLE_USERNAME=somchai2026

# Gemini - คิดเรื่องและเขียนบท (ฟรี) https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pollinations - สร้างภาพประกอบ ต้องมี token ไม่งั้นติดลายน้ำ https://auth.pollinations.ai
POLLINATIONS_TOKEN=

# Hugging Face - ทำให้ภาพขยับ (สำรอง ~7 ช็อต/วัน) https://huggingface.co/settings/tokens
HF_TOKEN=

# Kaggle - ทำให้ภาพขยับ (หลัก 30 ชม. GPU/สัปดาห์) https://www.kaggle.com/settings/api
# ชื่อที่อยู่ใน URL โปรไฟล์ เช่น kaggle.com/somchai2026
KAGGLE_USERNAME=
# token รูปแบบใหม่ ขึ้นต้นด้วย KGA (ของเดิมที่เป็น username+key ใช้ไม่ได้แล้ว)
KAGGLE_API_TOKEN=

# YouTube - อัปโหลด ดูวิธีขอใน SETUP.md
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
